*.swp
*.swo
*~
.idea/
.codex
.github

# OS files
.DS_Store
Thumbs.db

# Toolchain (if built locally)
toolchain/
cross/
memory/

# Newlib source, build artifacts, and sysroot
userspace/newlib/
userspace/newlib-build/
