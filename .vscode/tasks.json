{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build vkernel (Linux)",
      "type": "shell",
      "command": "make",
      "args": [
        "DEBUG=1",
        "disk"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "build vkernel (Windows)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "vkernel.sln",
        "/m",
        "/p:Configuration=Debug",
        "/p:Platform=x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "qemu debug (Linux)",
      "type": "shell",
      "command": "${workspaceFolder}/run_qemu.sh",
      "args": [
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build vkernel (Linux)",
      "problemMatcher": []
    },
    {
      "label": "qemu debug (Windows)",
      "type": "shell",
      "command": "${workspaceFolder}\\run_qemu.bat",
      "args": [
        "Debug",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "build vkernel (Windows)",
      "problemMatcher": []
    }
  ]
}